<Window x:Class="PolyUKApp.Windows.CallDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:PolyUKApp.Windows"
        mc:Ignorable="d"
        Title="CallDataWindow" Height="1020" Width="840"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="Images/PUKIco.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="800"/>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border x:Name="TopBar1"
            Background="{DynamicResource Accent}"
            Grid.Column="0"
            Grid.Row="0"
            CornerRadius="5,5,0,0"
            BorderBrush="{DynamicResource AccentBorder}"
            BorderThickness="1"
            MouseDown="TopBar1_MouseDown">
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button x:Name="BtnPrint"
                    Width="40" Height="35"
                    Content="🖶"
                    FontWeight="Bold"
                    Style="{DynamicResource ControlButtonTheme}"
                    Click="BtnPrint_Click"/>
                <Button x:Name="BtnClose"
                    Width="40" Height="35"
                    Content="X"
                    Style="{DynamicResource ControlButtonTheme}"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,0"
                    Click="BtnClose_Click"/>
            </StackPanel>
        </Border>


        <Border x:Name="TitleBorder1"
            Background="{DynamicResource BackgroundBase}"
            Grid.Column="0"
            Grid.Row="1"
            CornerRadius="0,0,0,0"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            VerticalAlignment="Stretch"/>

        <StackPanel Orientation="Horizontal"
                    Grid.Column="0"
                    Grid.Row="1"
                    Margin="10">
            <TextBlock Text="Call Data"
                   Foreground="{DynamicResource Accent}"
                   FontSize="32"
                   FontFamily="Aptos"
                   FontWeight="Bold"/>

        </StackPanel>



        <Border x:Name="WTNBackground1"
            Background="{DynamicResource BackgroundBase}"
            Grid.Column="0"
            Grid.Row="2"
            CornerRadius="0,0,5,5"
            VerticalAlignment="Stretch"/>

        <ScrollViewer Grid.Row="2">
            
            <StackPanel Grid.Row="2" Margin="10,20,10,0" x:Name="BaseStackPanel">

                <StackPanel Orientation="Horizontal"
                            Grid.Column="0"
                            Grid.Row="2"
                            Margin="0,0,0,15"
                            HorizontalAlignment="Left">
                    <Button x:Name="BtnThisWeek"
                            Margin="5,0,0,0"
                            Content="This Week"
                            Click="BtnThisWeek_Click"
                            Command="{Binding CallHeatmap.ThisWeekCommand}"
                            Width="80"
                            Style="{DynamicResource GeneralButtonTheme}"
                            Visibility="Visible"
                            HorizontalAlignment="Right"/>
                    <Button x:Name="BtnLastWeek"
                            Margin="20,0,0,0"
                            Content="Last Week"
                            Click="BtnLastWeek_Click"
                            Command="{Binding CallHeatmap.LastWeekCommand}"
                            Width="80"
                            Style="{DynamicResource GeneralButtonTheme}"
                            Visibility="Visible"
                            HorizontalAlignment="Right"/>
                </StackPanel>

                <DataGrid x:Name="WeeklyCallDataGrid"
                          AutoGenerateColumns="False"
                          Style="{DynamicResource DataGridTheme}"
                          CellStyle="{DynamicResource DataGridCellTheme}"
                          ColumnHeaderStyle="{DynamicResource ColumnHeaderTheme}"
                          Margin="0,0,0,10"
                          MinHeight="100">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Sales Person"     Binding="{Binding SalesPerson}"/>
                        <DataGridTextColumn Header="Monday"       Binding="{Binding Monday}" />
                        <DataGridTextColumn Header="Tuesday"       Binding="{Binding Tuesday}" />
                        <DataGridTextColumn Header="Wednesday"       Binding="{Binding Wednesday}" />
                        <DataGridTextColumn Header="Thursday"       Binding="{Binding Thursday}" />
                        <DataGridTextColumn Header="Friday"       Binding="{Binding Friday}" />
                        <DataGridTextColumn Header="Calls Connected"     Binding="{Binding CallsConnected}" />
                        <DataGridTextColumn Header="Average Call Time"    Binding="{Binding AverageCallTime}" />
                        <DataGridTextColumn Header="Target"    Binding="{Binding Target}" />
                        
                        <DataGridTextColumn Header="Total Time" Binding="{Binding TotalTime}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalStatus}" Value="over">
                                            <Setter Property="Foreground" Value="Green" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TotalStatus}" Value="under">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <Separator Margin="10,10,10,10"
                           Foreground="{DynamicResource Border}"/>

                <Button x:Name="BtnCallTimeToggle"
                        Width="120"
                        Content="{Binding DurationByWeek.ToggleButtonText}"
                        Command="{Binding DurationByWeek.ToggleViewCommand}"
                        HorizontalAlignment="Left"
                        Margin="5"
                        Padding="12,4"
                        Style="{DynamicResource GeneralButtonTheme}"
                        Click="BtnCallTimeToggle_Click"/>

                <StackPanel x:Name="NameStack" Grid.Column="0" Margin="8" VerticalAlignment="Center" Orientation="Vertical">
                    <TextBlock x:Name="TxtSalesPeople" Text="Sales People" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Text}"/>
                    <ItemsControl ItemsSource="{Binding DurationByWeek.OwnerFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Owner}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          Foreground="{Binding Color}"
                                          FontWeight="SemiBold"
                                          Margin="5,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Weekly Call Time"
                           Foreground="{DynamicResource Accent}"
                           FontSize="16"
                           Margin="5,5,0,10"/>

                <lvc:CartesianChart Height="400"
                                    MinWidth="800"
                                    HorizontalAlignment="Stretch"
                    Series="{Binding DurationByWeek.Series}"
                    XAxes="{Binding DurationByWeek.XAxes}"
                    YAxes="{Binding DurationByWeek.YAxes}"
                    LegendPosition="Hidden" ZoomMode="X" TooltipPosition="Right" FindingStrategy="ExactMatch" LegendTextSize="12" TooltipTextSize="12"/>

                <Separator Margin="20"
                           Foreground="{DynamicResource Border}"/>

                <TextBlock Text="Daily Average"
                           Foreground="{DynamicResource Accent}"
                           FontSize="16"
                           Margin="5,10,0,10"/>

                <lvc:CartesianChart Height="200"
                                    MinWidth="800"
                                    HorizontalAlignment="Stretch"
                    Series="{Binding NormalisedDuration.Series}"
                    XAxes="{Binding NormalisedDuration.XAxes}"
                    YAxes="{Binding NormalisedDuration.YAxes}"
                    LegendPosition="Hidden" ZoomMode="X" TooltipPosition="Right" FindingStrategy="ExactMatch" LegendTextSize="12" TooltipTextSize="12"/>



                <Separator Margin="20"
                           Foreground="{DynamicResource Border}"/>

                <TextBlock Text="Calls Heatmap"
                           Foreground="{DynamicResource Accent}"
                           FontSize="16"
                           Margin="5,0,0,10"/>

                <lvc:CartesianChart
                    Series="{Binding CallHeatmap.HeatSeries}"
                    XAxes="{Binding CallHeatmap.HeatXAxes}"
                    YAxes="{Binding CallHeatmap.HeatYAxes}"
                    Height="250" />

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
