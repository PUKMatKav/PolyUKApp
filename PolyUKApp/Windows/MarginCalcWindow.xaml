<Window x:Class="PolyUKApp.Windows.MarginCalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolyUKApp.Windows"
        mc:Ignorable="d"
        Title="MarginCalcWindow" Height="600" Width="850"    
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="Images/PUKIco.ico">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Border x:Name="TopBar0"
            Background="{DynamicResource Accent}"
            CornerRadius="5,5,0,0"
            BorderBrush="{DynamicResource AccentBorder}"
            BorderThickness="1,1,1,0"
            MouseDown="TopBar0_MouseDown"/>

        <Border Background="{DynamicResource BackgroundBase}"
            Grid.Row="2"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1,0"
            RenderOptions.EdgeMode="Aliased"
            Opacity="1"/>

        <Border x:Name="LogoBar0"
            Background="{DynamicResource BackgroundMid}"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1,0,1,1"
            RenderOptions.EdgeMode="Aliased">
           
        </Border>
       

        <Border x:Name="BotBar0"
            Background="{DynamicResource BackgroundMid}"
            Grid.Row="3"
            CornerRadius="0,0,5,5"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"/>

        <Grid x:Name="DisplayGrid"
          Grid.Row="2"
          Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="CalBorder0a"
                Grid.Row="0"
                CornerRadius="5,0,0,5"
                Background="{DynamicResource BackgroundLight}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1,1,0,1"
                Margin="10,20,0,5"
                RenderOptions.EdgeMode="Aliased">
                <StackPanel x:Name="MainPanelH1a"
                            Margin="10,5,0,0"
                            Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Current Margin"
                                   Foreground="{DynamicResource Accent}"
                                   FontWeight="Bold"
                                   FontSize="16"/>
                        <TextBlock Text="Cost Price (GBP)"
                                   Foreground="{DynamicResource Text}"
                                   FontFamily="Aptos"
                                   Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                            Height="20"
                            CornerRadius="10"
                                Width="100"
                                HorizontalAlignment="Left">
                            <TextBox x:Name="CostPriceTextBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Text}"
                                 BorderThickness="0"
                                 Padding="10,2"
                                 HorizontalContentAlignment="Left"
                                     TextChanged="CostPriceTextBox_TextChanged"
                                 local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                        <TextBlock Text="Sale Price (GBP)"
                                   Foreground="{DynamicResource Text}"
                                   FontFamily="Aptos"
                                   Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                            Height="20"
                            CornerRadius="10"
                                Width="100"
                                HorizontalAlignment="Left">
                            <TextBox x:Name="SalePriceTextBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Text}"
                                 BorderThickness="0"
                                 Padding="10,2"
                                 HorizontalContentAlignment="Left"
                                     TextChanged="SalePriceTextBox_TextChanged"
                                 local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,21,0,0">
                        <TextBlock Text="Carriage Cost"
                                   Foreground="{DynamicResource Text}"
                                   FontFamily="Aptos"
                                   Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                            Height="20"
                            CornerRadius="10"
                                Width="100"
                                HorizontalAlignment="Left">
                            <TextBox x:Name="CarriageCostTextBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Text}"
                                 BorderThickness="0"
                                 Padding="10,2"
                                 HorizontalContentAlignment="Left"
                                     TextChanged="CarriageCostTextBox_TextChanged"
                                 local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                        <TextBlock Text="Carriage Charge"
                                Foreground="{DynamicResource Text}"
                                FontFamily="Aptos"
                                Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                         Height="20"
                         CornerRadius="10"
                             Width="100"
                             HorizontalAlignment="Left">
                            <TextBox x:Name="CarriageChargeTextBox"
                              Background="Transparent"
                              Foreground="{DynamicResource Text}"
                              BorderThickness="0"
                              Padding="10,2"
                              HorizontalContentAlignment="Left"
                                     TextChanged="CarriageChargeTextBox_TextChanged"
                              local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border x:Name="CalBorder1a"
                Grid.Row="0"
                    Grid.Column="1"
                CornerRadius="0,5,5,0"
                Background="{DynamicResource BackgroundLight}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,1,1"
                Margin="0,20,10,5"
                RenderOptions.EdgeMode="Aliased">

                <StackPanel x:Name="MainPanelH2a"
                            Margin="-30,5,0,0"
                            Orientation="Horizontal">
                    <StackPanel Orientation="Vertical"
                                Margin="0,71,0,0">
                        <TextBlock Text="Quantity"
                                Foreground="{DynamicResource Text}"
                                FontFamily="Aptos"
                                Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                         Height="20"
                         CornerRadius="10"
                             Width="100"
                             HorizontalAlignment="Left">
                            <TextBox x:Name="QtyTextBox"
                              Background="Transparent"
                              Foreground="{DynamicResource Text}"
                              BorderThickness="0"
                              Padding="10,2"
                              HorizontalContentAlignment="Left"
                                     TextChanged="QtyTextBox_TextChanged"
                              local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                Margin="30,21,0,12">
                        <Border Width="150"
                                Height="100"
                                CornerRadius="5"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BackgroundMid}"
                                Background="{DynamicResource BackgroundLight}">
                            <StackPanel>
                                <TextBlock Text="Margin"
                                       HorizontalAlignment="Center"
                                       Margin="10,25,10,0"
                                       Foreground="{DynamicResource Accent}"
                                       FontWeight="Bold"/>
                                <TextBlock x:Name="FinalMarginCalcText"
                                        Text="NaN %"
                                       HorizontalAlignment="Center"
                                       Margin="0,5"
                                       Foreground="{DynamicResource Accent}"
                                       FontWeight="Bold"
                                           FontSize="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </StackPanel>

            </Border>

            <Border x:Name="CalBorder0b"
                Grid.Row="1"
                CornerRadius="5,0,0,5"
                Background="{DynamicResource BackgroundLight}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1,1,0,1"
                Margin="10,5,0,5"
                RenderOptions.EdgeMode="Aliased">
                <StackPanel x:Name="MainPanelH1b"
                            Margin="10,10,0,0"
                            Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="Sales Price at Current Margin"
                                   FontSize="16"
                                   FontFamily="Aptos"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,30">
                            <StackPanel>
                                <TextBlock Text="Current Margin"
                                           FontFamily="Aptos"
                                           Foreground="{DynamicResource Text}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CurrentMarginNewCostText"
                                        Text="NaN %"
                                       HorizontalAlignment="Center"
                                       Margin="0,5"
                                       Foreground="{DynamicResource Accent}"
                                       FontWeight="Bold"
                                           FontSize="20"/>
                            </StackPanel>
                            <TextBlock Text=">"
                                       VerticalAlignment="Center"
                                       Margin="20,10"
                                       FontSize="20"
                                       Foreground="{DynamicResource Accent}"/>
                            <StackPanel>
                                <TextBlock Text="New Cost Price"
                                           FontFamily="Aptos"
                                           Foreground="{DynamicResource Text}"
                                           Margin="0,0,0,10"
                                           HorizontalAlignment="Center"/>
                                <Border Background="{DynamicResource BackgroundMid}"
                                        Height="20"
                                        CornerRadius="10"
                             Width="100"
                             HorizontalAlignment="Left">
                                    <TextBox x:Name="NewCostTextBox"
                              Background="Transparent"
                              Foreground="{DynamicResource Text}"
                              BorderThickness="0"
                              Padding="10,2"
                              HorizontalContentAlignment="Left"
                              TextChanged="NewCostTextBox_TextChanged"
                              local:TextBoxBehavior.NumericOnly="True"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border x:Name="CalBorder1b"
                Grid.Row="1"
                    Grid.Column="1"
                CornerRadius="0,5,5,0"
                Background="{DynamicResource BackgroundLight}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,1,1"
                Margin="0,5,10,5"
                RenderOptions.EdgeMode="Aliased">
                <StackPanel x:Name="MainPanelH2b"
                            Margin="00,10,10,0"
                            Orientation="Horizontal">
                    <TextBlock Text=">"
                                       VerticalAlignment="Center"
                                       Margin="-5,15,20,10"
                                       FontSize="20"
                                       Foreground="{DynamicResource Accent}"/>
                    <StackPanel Margin="0,49,0,0">
                        <TextBlock Text="New Selling Price"
                                           FontFamily="Aptos"
                                           Foreground="{DynamicResource Text}"
                                           Margin="0,0,0,0"
                                           HorizontalAlignment="Center"/>
                        <TextBlock     x:Name="NewSellingPriceCalcText"
                                        Text="£1.00"
                                       HorizontalAlignment="Center"
                                       Margin="0,5"
                                       Foreground="{DynamicResource Accent}"
                                       FontWeight="Bold"
                                           FontSize="20"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="CalBorder0c"
                Grid.Row="2"
                CornerRadius="5,0,0,5"
                Background="{DynamicResource BackgroundLight}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1,1,0,1"
                Margin="10,5,0,5"
                RenderOptions.EdgeMode="Aliased">
                <StackPanel x:Name="MainPanelH3a"
                            Margin="10,5,0,0"
                            Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="New Target Margin"
                                   Foreground="{DynamicResource Accent}"
                                   FontWeight="Bold"
                                   FontSize="16"/>
                        <TextBlock Text="Cost Price (GBP)"
                                   Foreground="{DynamicResource Text}"
                                   FontFamily="Aptos"
                                   Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                                Height="20"
                                CornerRadius="10"
                                    Width="100"
                                    HorizontalAlignment="Left">         
                            <TextBox x:Name="NewCostPriceTextBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Text}"
                                 BorderThickness="0"
                                 Padding="10,2"
                                 HorizontalContentAlignment="Left"
                                     TextChanged="NewCostPriceTextBox_TextChanged"
                                 local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                        <TextBlock Text="Target Margin %"
                                   Foreground="{DynamicResource Text}"
                                   FontFamily="Aptos"
                                   Margin="0,10,0,5"/>
                                    <Border Background="{DynamicResource BackgroundMid}"
                                    Height="20"
                                    CornerRadius="10"
                                        Width="100"
                                        HorizontalAlignment="Left">
                            <TextBox x:Name="TargetMarginTextBox"
                             Background="Transparent"
                             Foreground="{DynamicResource Text}"
                             BorderThickness="0"
                             Padding="10,2"
                             HorizontalContentAlignment="Left"
                                     TextChanged="TargetMarginTextBox_TextChanged"
                             local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="-29,21,0,0">
                        <TextBlock Text="Carriage Cost"
                            Foreground="{DynamicResource Text}"
                            FontFamily="Aptos"
                            Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                             Height="20"
                             CornerRadius="10"
                                 Width="100"
                                 HorizontalAlignment="Left">
                            <TextBox x:Name="NewCarriageCostTextBox"
                              Background="Transparent"
                              Foreground="{DynamicResource Text}"
                              BorderThickness="0"
                              Padding="10,2"
                              HorizontalContentAlignment="Left"
                                     TextChanged="NewCarriageCostTextBox_TextChanged"
                              local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                        <TextBlock Text="Carriage Charge"
                                 Foreground="{DynamicResource Text}"
                                 FontFamily="Aptos"
                                 Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                              Height="20"
                              CornerRadius="10"
                                  Width="100"
                                  HorizontalAlignment="Left">
                            <TextBox x:Name="NewCarriageChargeTextBox"
                                   Background="Transparent"
                                   Foreground="{DynamicResource Text}"
                                   BorderThickness="0"
                                   Padding="10,2"
                                   HorizontalContentAlignment="Left"
                                     TextChanged="NewCarriageChargeTextBox_TextChanged"
                                   local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            
            <Border x:Name="CalBorder1c"
                Grid.Row="2"
                    Grid.Column="1"
                CornerRadius="0,5,5,0"
                Background="{DynamicResource BackgroundLight}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,1,1"
                Margin="0,5,10,5"
                RenderOptions.EdgeMode="Aliased">

                <StackPanel x:Name="MainPanelH3b"
             Margin="-30,5,0,0"
             Orientation="Horizontal">
                    <StackPanel Orientation="Vertical"
                 Margin="0,71,0,0">
                        <TextBlock Text="Quantity"
                                 Foreground="{DynamicResource Text}"
                                 FontFamily="Aptos"
                                 Margin="0,10,0,5"/>
                        <Border Background="{DynamicResource BackgroundMid}"
                          Height="20"
                          CornerRadius="10"
                              Width="100"
                              HorizontalAlignment="Left">
                            <TextBox x:Name="NewQtyTextBox"
                               Background="Transparent"
                               Foreground="{DynamicResource Text}"
                               BorderThickness="0"
                               Padding="10,2"
                               HorizontalContentAlignment="Left"
                                     TextChanged="NewQtyTextBox_TextChanged"
                               local:TextBoxBehavior.NumericOnly="True"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                 Margin="30,21,0,12">
                        <Border Width="150"
                 Height="100"
                 CornerRadius="5"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource BackgroundMid}"
                 Background="{DynamicResource BackgroundLight}">
                            <StackPanel>
                                <TextBlock Text="New Sale Price"
                        HorizontalAlignment="Center"
                        Margin="10,25,10,0"
                        Foreground="{DynamicResource Accent}"
                        FontWeight="Bold"/>
                                <TextBlock x:Name="NewMarginSalesPriceValueText"
                                    Text="£10.00"
                        HorizontalAlignment="Center"
                        Margin="0,5"
                        Foreground="{DynamicResource Accent}"
                        FontWeight="Bold"
                            FontSize="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="CurrentMarginExp"
                    Grid.Column="2"
                    Margin="10,30,10,15"
                    Background="{DynamicResource Accent}"
                    CornerRadius="5">
                <StackPanel Margin="10,5">
                    <TextBlock Text="Explanation"
                               Foreground="White"/>
                    <TextBox Background="Transparent"
                             Foreground="White"
                             Padding="2"
                             x:Name="CurrentMarginTextExp"
                             TextWrapping="Wrap"
                             IsHitTestVisible="False"
                             BorderThickness="0">
                        
                    </TextBox>
                </StackPanel>
                
            </Border>

        </Grid>

        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,0,10,0">
            <Button x:Name="BtnMinimise"
                    Width="40" Height="35"
                    Content="_"
                    Style="{DynamicResource ControlButtonTheme}"
                    Click="BtnMinimise_Click"/>
            <Button x:Name="BtnMaximise"
                    Width="40" Height="35"
                    Content="🗖"
                    Style="{DynamicResource ControlButtonTheme}"
                    Click="BtnMaximise_Click"/>
            <Button x:Name="BtnClose"
                    Width="40" Height="35"
                    Content="X"
                    Style="{DynamicResource ControlButtonTheme}"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
